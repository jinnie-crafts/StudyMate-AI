# ============================================================
# StudyMate AI — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file to version control.
# ============================================================

# --- Server Configuration ---
PORT=3001
NODE_ENV=production

# --- AI API Keys ---
# Your OpenRouter API Key for accessing AI models
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# NewsData.io API key for fresh news retrieval
# Get one at: https://newsdata.io/
NEWSDATA_API_KEY=pub_YOUR_KEY_HERE

# --- Firebase Admin SDK ---
# These are from your Firebase service account key JSON
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- CORS Configuration ---
# Comma-separated list of allowed origins for CORS
# Example: https://yourdomain.com,https://www.yourdomain.com,http://localhost:3000
ALLOWED_ORIGINS=https://aadirishi.in,https://www.aadirishi.in,https://studymate-ai-bc65e.web.app,http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# --- Security Thresholds ---
THREAT_WINDOW_HOURS=24
THREAT_WARNING_SCORE=50
THREAT_RATE_LIMIT_SCORE=100
THREAT_SUSPEND_SCORE=200
SEMANTIC_SECURITY_ENABLED=true
ENABLE_SECURITY_LOGGING=true
